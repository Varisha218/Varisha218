<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 260" width="900" height="260" role="img" aria-label="Varisha Fatima — CS Senior, Flutter and App Developer, AI Intern" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1B0A2E"/>
      <stop offset="0.55" stop-color="#4A1D6B"/>
      <stop offset="1" stop-color="#C2185B"/>
    </linearGradient>
    <linearGradient id="w1" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#C2185B" stop-opacity="0.55"/>
      <stop offset="1" stop-color="#F8BBD0" stop-opacity="0.45"/>
    </linearGradient>
    <linearGradient id="w2" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#F8BBD0" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#4A1D6B" stop-opacity="0.6"/>
    </linearGradient>
    <linearGradient id="ul" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#F8BBD0" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#F8BBD0"/>
      <stop offset="1" stop-color="#F8BBD0" stop-opacity="0"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <clipPath id="round"><rect width="900" height="260" rx="18"/></clipPath>
  </defs>
  <style>
    .name{font:800 56px 'Segoe UI',Helvetica,Arial,sans-serif;fill:#fff;letter-spacing:1px;animation:rise 1.2s ease-out both}
    .hi{font:600 18px 'Fira Code','Courier New',monospace;fill:#F8BBD0;animation:rise 1s ease-out both}
    .role{font:600 22px 'Fira Code','Courier New',monospace;fill:#fff;opacity:0}
    .r1{animation:cycle 12s infinite 0s}
    .r2{animation:cycle 12s infinite 3s}
    .r3{animation:cycle 12s infinite 6s}
    .r4{animation:cycle 12s infinite 9s}
    .g{font:700 26px 'Fira Code','Courier New',monospace;fill:#F8BBD0;opacity:.22}
    .f1{animation:float 6s ease-in-out infinite alternate}
    .f2{animation:float 8s ease-in-out infinite alternate -2s}
    .f3{animation:float 7s ease-in-out infinite alternate -4s}
    .tw{animation:twinkle 3s ease-in-out infinite}
    .cur{animation:blink 1s steps(1) infinite}
    @keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
    @keyframes cycle{0%{opacity:0;transform:translateY(10px)}3%{opacity:1;transform:none}22%{opacity:1;transform:none}25%{opacity:0;transform:translateY(-10px)}100%{opacity:0}}
    @keyframes float{from{transform:translateY(0) rotate(-4deg)}to{transform:translateY(-16px) rotate(4deg)}}
    @keyframes twinkle{0%,100%{opacity:.1}50%{opacity:.9}}
    @keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
  </style>

  <g clip-path="url(#round)">
    <rect width="900" height="260" fill="url(#bg)"/>

    <!-- twinkling stars -->
    <g fill="#fff">
      <circle class="tw" cx="60"  cy="40"  r="2"/>
      <circle class="tw" cx="170" cy="95"  r="1.5" style="animation-delay:-1s"/>
      <circle class="tw" cx="330" cy="30"  r="2"   style="animation-delay:-2s"/>
      <circle class="tw" cx="560" cy="55"  r="1.5" style="animation-delay:-.5s"/>
      <circle class="tw" cx="700" cy="28"  r="2"   style="animation-delay:-1.5s"/>
      <circle class="tw" cx="840" cy="85"  r="1.5" style="animation-delay:-2.5s"/>
      <circle class="tw" cx="780" cy="150" r="2"   style="animation-delay:-.8s"/>
      <circle class="tw" cx="40"  cy="150" r="1.5" style="animation-delay:-1.8s"/>
    </g>

    <!-- floating code glyphs -->
    <text class="g f1" x="70"  y="215">{ }</text>
    <text class="g f2" x="760" y="90">&lt;/&gt;</text>
    <text class="g f3" x="640" y="200">C++</text>
    <text class="g f1" x="230" y="225" style="animation-delay:-3s">AI</text>
    <text class="g f2" x="820" y="200" style="animation-delay:-1s">()</text>
    <text class="g f3" x="450" y="40" style="animation-delay:-5s">01</text>

    <!-- waves -->
    <g>
      <path fill="url(#w2)" d="M0 205 Q225 165 450 205 T900 205 T1350 205 T1800 205 V260 H0 Z">
        <animateTransform attributeName="transform" type="translate" from="-900 0" to="0 0" dur="14s" repeatCount="indefinite"/>
      </path>
      <path fill="url(#w1)" d="M0 220 Q225 190 450 220 T900 220 T1350 220 T1800 220 V260 H0 Z">
        <animateTransform attributeName="transform" type="translate" from="0 0" to="-900 0" dur="9s" repeatCount="indefinite"/>
      </path>
    </g>

    <!-- text -->
    <text class="hi" x="450" y="62" text-anchor="middle">&lt; hello, world /&gt;</text>
    <text class="name" x="450" y="128" text-anchor="middle" filter="url(#glow)">Varisha Fatima</text>
    <rect x="250" y="142" width="400" height="2" fill="url(#ul)">
      <animate attributeName="width" values="0;400;400" keyTimes="0;0.4;1" dur="2s" fill="freeze"/>
      <animate attributeName="x" values="450;250;250" keyTimes="0;0.4;1" dur="2s" fill="freeze"/>
    </rect>

    <text class="role r1" x="450" y="180" text-anchor="middle">CS Senior @ Institute of Space Technology</text>
    <text class="role r2" x="450" y="180" text-anchor="middle">Flutter &amp; App Developer</text>
    <text class="role r3" x="450" y="180" text-anchor="middle">AI Intern · Deepfake Detection</text>
    <text class="role r4" x="450" y="180" text-anchor="middle">Where Code Meets Creativity</text>
  </g>
</svg>
